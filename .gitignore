# Python bytecode and cache directories
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/

# Environment secrets
.env
.env.*
*.key
*.pem

# Generated logs and results
logs/*.csv
logs/*.json
logs/*.log
logs/backtest_archive/
# Live position entry-context journal for the Telegram status commands
# (already covered by logs/*.json; listed explicitly as it contains trade context)
logs/live_positions.json
logs/live_positions.json.tmp

# Local backups, trained artifacts, and generated analysis output
backup/
models/
output/

# Backup / patch files
*.bak
*.bak_*

# Process ID files
*.pid

# PowerShell $null redirect artefact (literal filename "$null")
$null

# One-off local scripts
diag.py

# PDF exports of the codebase
compact_project_code.pdf

# Version stub files (e.g. "2.4.0" dropped by some package managers)
[0-9]*.*
# ...but versioned DB migration modules (data/migrations/001_initial.py etc.)
# are real source files, not stubs.
!data/migrations/*.py

# One-off local migration/patch script
fix_ingestion.py

# SQLite databases and their transient sidecar files.
# *.sqlite alone does NOT match the -wal / -shm suffixes, which is how
# data/market_data_mt5.sqlite-{wal,shm} ended up committed. A tracked sidecar
# aborts every branch switch made while the database is open.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# Prop challenge: auth-sensitive / volatile artifacts stay local only
data/challenge_browser_profile/
data/challenge_tokens.json
logs/challenge/

# Prop challenge: manual-system runtime state (day state, journal, sent alerts)
data/manual/

# UI node_modules and runtime log
UI 3.7 flsah updated v3/node_modules/
UI 3.7 flsah updated v3/ui_server.log

# Forex trial-window heartbeat
logs/trial_window_heartbeat.txt

# Scratch diagnostic outputs (screenshots, console logs, one-off scripts in logs/)
logs/*.txt
logs/*.png
logs/*.py
logs/*.js
logs/*.joblib
logs/*.lock
logs/halfyear_fx/

# Freebuff IDE artifacts
.freebuff/

# Challenge runtime (browser profiles, state, live trades)
data/challenge_browser_profile_*/
data/challenge_state.json
data/challenge_trades.csv

# Regenerated / volatile data
*.db
data/usstocks_export/
data/book_bars/
backups/
# TZ 6.5: database backups stay local

# TZ 6.6: logs/setup.py is real source code (structured logging setup), not a
# scratch script — the logs/*.py rule above targets one-off diagnostics only.
!logs/setup.py
