# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# --- Market data ---
DATA_MODE=live
# Deployment authority is config.deployment.mode; DRY_RUN is only an extra brake.
# DASHBOARD_CONTROL_TOKEN=set-a-long-random-token  # DEPRECATED: /api/control/*
#   now returns 501 for every action (browser mutation controls are disabled
#   until a command bus exists; use the authenticated Telegram control bot).

# --- Telegram alerts & control ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Restrict sensitive commands to this chat ID. If neither admin nor chat ID is
# configured, sensitive commands fail closed for everyone.
# Get your chat ID: message @userinfobot in Telegram.
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# --- Simulation ---
# SIMULATION_SEED=42            # set for reproducible runs
# SIMULATION_WARMUP_TICKS=5000  # default
# DRY_RUN=1                     # log orders only, don't send to MT5

# --- Model / pipeline ---
MODEL_PATH=output/models/xauusd_direction_model.joblib
SIGNAL_LOG_DB_PATH=data/signal_log.db
PIPELINE_N_CANDLES=300
# Model Registry root (ТЗ 8.4). Default when unset: models/registry/.
# The registry catalogs trained models (index.jsonl + active.json pointer);
# physical model files are never moved.
# MODEL_REGISTRY_ROOT=models/registry

# --- Feature Store (ТЗ 8.3) ---
# SQLite catalog of computed feature snapshots. Configured in config/config.yaml
# under `features.store` (enabled: false by default -> no behaviour change).
# Optional env override for the store DB path; when unset, config
# `features.store.db_path`, then `general.db_path` (candles DB) is used.
# FEATURE_STORE_DB_PATH=data/feature_store.sqlite

# --- Frozen paper accumulator (/paper liveness counter) ---
# PAPER_MANIFEST_PATH=config/paper/xauusd_wide_trend_filtered.json
# PAPER_LEDGER_DB=data/paper_forward.sqlite

# --- Signal Desk ledger bridge (Wave 2, MQL5 observer plan) ---
# STRICT SIGNED INGRESS (security contract): /api/ledger/ingest rejects every
# request without a valid X-Ledger-Signature (HMAC-SHA256 over the exact raw
# body). LEDGER_INGEST_SECRET is REQUIRED server-side; without it the endpoint
# is fail-closed (503). There is no unsigned/bearer-only path.
# LEDGER_INGEST_TOKEN=set-a-long-random-token     # remote server bearer (server + signing proxy only)
# LEDGER_OWNER_TOKEN=set-a-different-owner-token  # owner reads; falls back to ingest token
# LEDGER_INGEST_SECRET=set-an-hmac-secret         # REQUIRED for signed ingress
# LEDGER_INGEST_URL=https://your-host/api/ledger/ingest  # signing proxy only (never in MQL5)
# --- Local loopback signing proxy (MQL5 observer path) ---
# The MQL5 observer NEVER holds the remote bearer or HMAC secret. It posts to
# the loopback proxy only; the proxy signs and forwards.
# OBSERVER_PROXY_URL=http://127.0.0.1:8787/v1/observer/ingest  # MQL5 input
# OBSERVER_PROXY_TOKEN=set-a-separate-proxy-token             # MQL5 input + proxy env

# --- Provenance module (ТЗ 8.7 / P2-3 / P2-51) ---
# Configured in config/config.yaml under `provenance`
# (max_snapshot_age_ms; store.enabled=false by default -> no behaviour
# change). Optional env override for the audit store DB path; when unset,
# config `provenance.store.db_path`, then `general.db_path` is used.
# PROVENANCE_STORE_DB_PATH=data/provenance_store.sqlite

# --- MT5 adapter rate limiting (ТЗ 8.6 / P2-7) ---
# Max MetaTrader5 API calls per second enforced by mt5_adapter.MT5RateLimiter.
# UNSET or 0 = disabled (default; preserves existing behaviour). Positive N =
# token-bucket with burst=N. Applies to MT5Client users that opt in.
# MT5_RATE_LIMIT_MAX_CPS=10

# --- Services (Phase 3 / Step 10, ТЗ 8.1 / 8.2 / 8.8) ---
# Standalone processes: python -m services.ledger_bridge | telegram_bot | news_feed.
# Ports and intervals are configured in config/config.yaml under `services`;
# the SERVICE_* env vars below override the config when set.
# SERVICE_LEDGER_BRIDGE_HEALTH_PORT=8791
# SERVICE_LEDGER_BRIDGE_WATERMARK_MAX_AGE_MIN=30   # P2-19 watermark budget
# SERVICE_TELEGRAM_BOT_HEALTH_PORT=8792
# SERVICE_NEWS_FEED_HEALTH_PORT=8793
# SERVICE_NEWS_FEED_MAX_CACHE_AGE_HOURS=6          # calendar cache freshness
# SERVICE_NEWS_FEED_REFRESH_INTERVAL_SECONDS=900
