# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# --- Market data ---
DATA_MODE=live
# Deployment authority is config.deployment.mode; DRY_RUN is only an extra brake.
# DASHBOARD_CONTROL_TOKEN=set-a-long-random-token  # DEPRECATED: /api/control/*
#   now returns 501 for every action (browser mutation controls are disabled
#   until a command bus exists; use the authenticated Telegram control bot).

# --- Telegram alerts & control ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Restrict sensitive commands to this chat ID. If neither admin nor chat ID is
# configured, sensitive commands fail closed for everyone.
# Get your chat ID: message @userinfobot in Telegram.
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# --- Simulation ---
# SIMULATION_SEED=42            # set for reproducible runs
# SIMULATION_WARMUP_TICKS=5000  # default
# DRY_RUN=1                     # log orders only, don't send to MT5

# --- Model / pipeline ---
MODEL_PATH=output/models/xauusd_direction_model.joblib
SIGNAL_LOG_DB_PATH=data/signal_log.db
PIPELINE_N_CANDLES=300

# --- Frozen paper accumulator (/paper liveness counter) ---
# PAPER_MANIFEST_PATH=config/paper/xauusd_wide_trend_filtered.json
# PAPER_LEDGER_DB=data/paper_forward.sqlite

# --- Signal Desk ledger bridge (Wave 2, MQL5 observer plan) ---
# Server-side (realtime/app.py) ingest endpoint auth. When the server has no
# LEDGER_INGEST_TOKEN configured, /api/ledger/ingest fails closed (403).
# LEDGER_INGEST_TOKEN=set-a-long-random-token
# LEDGER_OWNER_TOKEN=set-a-different-owner-token   # reads; falls back to ingest token
# LEDGER_INGEST_SECRET=optional-hmac-secret        # when set, the Python bridge
#   must sign every envelope (X-Ledger-Signature). The MQL5 observer cannot
#   compute HMAC and relies on HTTPS + bearer token only, so keep this unset
#   if you ingest from MQL5, or deploy the observer without the secret.
# LEDGER_INGEST_URL=https://your-host/api/ledger/ingest  # producer-side config
