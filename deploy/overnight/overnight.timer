# Runs the overnight pipeline once a day at 03:00 local time.
# Adjust OnCalendar to your preferred time (systemd calendar syntax).
[Unit]
Description=Trigger the overnight XAUUSD model pipeline daily

[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
